# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Optional. Without it, web search is disabled.
TAVILY_API_KEY=

OWNER_NAME=Arsene
OWNER_TIMEZONE=Europe/Brussels

# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Only this user gets answers.
TELEGRAM_OWNER_USER_ID=

# polling: no public URL needed (default). webhook: needs the tunnel profile.
TELEGRAM_MODE=polling
# Webhook mode only. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Webhook mode only. Points at the cloudflared quick tunnel in compose.yaml.
CLOUDFLARED_METRICS_URL=http://cloudflared:2000
# Webhook mode with a stable URL (named tunnel, AWS load balancer) instead:
# PUBLIC_BASE_URL=https://lupin.example.com

# Exposes POST /debug/chat on localhost:8080 for curl and Bruno.
DEBUG_API_ENABLED=true

# POSTGRES_PASSWORD=lupin
